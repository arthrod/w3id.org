# https://w3id.org/digest-law
# American Legal Digest — open, source-grounded digests of legal issues,
# organised by jurisdiction. First jurisdiction: United States (/us/...).
#
# ## Contact
# This space is administered by:
#
# Arthur S. Rodrigues
# arthursrodrigues@gmail.com
# GitHub username: arthrod

# Turn off MultiViews
Options -MultiViews

RewriteEngine on

# --- United States corpus: https://w3id.org/digest-law/us/... ---
# Digest URIs: /us/{area}/.../{topic}/  (plus .../sources/{slug}/ and .../audit/)
RewriteRule ^us/?$ https://digest.law/ [R=303,NE,L]
RewriteRule ^us/(.*)$ https://digest.law/$1 [R=302,NE,L]

# --- Namespace root ---
RewriteRule ^$ https://digest.law/ [R=303,NE,L]

# --- Everything else ---
RewriteRule ^(.*)$ https://digest.law/$1 [R=302,NE,L]
